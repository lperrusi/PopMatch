rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile document (not subcollections)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
    }

    // Own follow requests inbox and privacy — flat paths avoid nested-match edge cases
    match /users/{uid}/incomingRequests/{requesterUid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/privacy/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Reads are client-side (feeds, follow status, friend profiles); all writes
    // go through Cloud Functions (Admin SDK, which bypasses these rules), so
    // clients must not write directly — prevents forging edges/activity as others.
    match /followEdges/{edgeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /socialActivities/{activityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Shared watchlist snapshots. Owner and recipient may read their own copies;
    // all writes go through the shareWatchlist Cloud Function (Admin SDK).
    match /sharedWatchlists/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.recipientUid == request.auth.uid ||
         resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    // Password-reset codes are written/read only by Cloud Functions (Admin SDK,
    // which bypasses rules). Clients must never read or write them.
    match /passwordResetCodes/{docId} {
      allow read, write: if false;
    }
  }
}
